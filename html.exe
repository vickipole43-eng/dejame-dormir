                        <circle cx="100" cy="110" r="45" fill="#fca5a5" />
                        <path d="M60 100 Q100 60 140 100 Q130 75 100 70 Q70 75 60 100 Z" fill="#475569" />
                        ${awake ? `
                            <circle cx="85" cy="105" r="9" fill="white" />
                            <circle cx="115" cy="105" r="9" fill="white" />
                            <circle cx="85" cy="105" r="4" fill="#0f172a" />
                            <circle cx="115" cy="105" r="4" fill="#0f172a" />
                            <path d="M75 90 L95 96" stroke="#475569" stroke-width="4" stroke-linecap="round"/>
                            <path d="M125 90 L105 96" stroke="#475569" stroke-width="4" stroke-linecap="round"/>
                            <ellipse cx="100" cy="128" rx="12" ry="16" fill="#991b1b" />
                            <path d="M92 118 Q100 122 108 118" stroke="white" stroke-width="3" fill="none"/>
                        ` : `
                            <path d="M78 108 Q85 114 92 108" stroke="#475569" stroke-width="3.5" fill="none" stroke-linecap="round"/>
                            <path d="M108 108 Q115 114 122 108" stroke="#475569" stroke-width="3.5" fill="none" stroke-linecap="round"/>
                            <path d="M93 125 Q100 129 107 125" stroke="#475569" stroke-width="3" fill="none" stroke-linecap="round"/>
                            <circle cx="72" cy="115" r="6" fill="#f43f5e" opacity="0.4" />
                            <circle cx="128" cy="115" r="6" fill="#f43f5e" opacity="0.4" />
                        `}
                    </svg>
                `
            },
            mishi: {
                name: 'Mishi',
                icon: '🐱',
                color: '#f59e0b',
                renderSVG: (awake) => `
                    <svg width="180" height="180" viewBox="0 0 200 200" class="drop-shadow-xl">
                        <rect x="30" y="110" width="140" height="60" rx="18" fill="#fde68a" />
                        <polygon points="60,65 80,100 45,95" fill="#f59e0b" />
                        <polygon points="140,65 120,100 155,95" fill="#f59e0b" />
                        <ellipse cx="100" cy="115" rx="50" ry="40" fill="#fbbf24" />
                        <ellipse cx="100" cy="122" rx="14" ry="10" fill="white" />
                        <polygon points="97,118 103,118 100,122" fill="#f43f5e" />
                        ${awake ? `
                            <ellipse cx="80" cy="108" rx="8" ry="12" fill="#10b981" />
                            <ellipse cx="120" cy="108" rx="8" ry="12" fill="#10b981" />
                            <line x1="80" y1="98" x2="80" y2="118" stroke="#064e3b" stroke-width="2.5"/>
                            <line x1="120" y1="98" x2="120" y2="118" stroke="#064e3b" stroke-width="2.5"/>
                            <path d="M92 128 Q100 122 108 128" stroke="#78350f" stroke-width="3" fill="none"/>
                        ` : `
                            <path d="M72 110 Q80 115 88 110" stroke="#78350f" stroke-width="3" fill="none" stroke-linecap="round"/>
                            <path d="M112 110 Q120 115 128 110" stroke="#78350f" stroke-width="3" fill="none" stroke-linecap="round"/>
                            <path d="M95 124 Q100 127 105 124" stroke="#78350f" stroke-width="2.5" fill="none"/>
                        `}
                        <line x1="55" y1="118" x2="35" y2="115" stroke="#78350f" stroke-width="2"/>
                        <line x1="55" y1="123" x2="38" y2="125" stroke="#78350f" stroke-width="2"/>
                        <line x1="145" y1="118" x2="165" y2="115" stroke="#78350f" stroke-width="2"/>
                        <line x1="145" y1="123" x2="162" y2="125" stroke="#78350f" stroke-width="2"/>
                    </svg>
                `
            },
            osito: {
                name: 'Osito',
                icon: '🐻',
                color: '#84cc16',
                renderSVG: (awake) => `
                    <svg width="180" height="180" viewBox="0 0 200 200" class="drop-shadow-xl">
                        <path d="M30 130 Q100 110 170 130 L170 180 L30 180 Z" fill="#b45309" />
                        <circle cx="60" cy="75" r="18" fill="#78350f" />
                        <circle cx="140" cy="75" r="18" fill="#78350f" />
                        <circle cx="100" cy="110" r="48" fill="#92400e" />
                        <ellipse cx="100" cy="120" rx="20" ry="15" fill="#fde68a" />
                        <ellipse cx="100" cy="113" rx="8" ry="6" fill="#451a03" />
                        ${awake ? `
                            <circle cx="80" cy="100" r="7" fill="white" />
                            <circle cx="120" cy="100" r="7" fill="white" />
                            <circle cx="80" cy="100" r="3" fill="black" />
                            <circle cx="120" cy="100" r="3" fill="black" />
                            <path d="M92 127 Q100 135 108 127" stroke="#451a03" stroke-width="3" fill="none"/>
                        ` : `
                            <path d="M74 102 Q82 107 90 102" stroke="#fde68a" stroke-width="3" fill="none"/>
                            <path d="M110 102 Q118 107 126 102" stroke="#fde68a" stroke-width="3" fill="none"/>
                            <path d="M95 125 Q100 128 105 125" stroke="#451a03" stroke-width="2.5" fill="none"/>
                        `}
                    </svg>
                `
            },
            nube: {
                name: 'Nube',
                icon: '☁️',
                color: '#38bdf8',
                renderSVG: (awake) => `
                    <svg width="180" height="180" viewBox="0 0 200 200" class="drop-shadow-xl">
                        <path d="M 50 130 A 25 25 0 0 1 60 80 A 35 35 0 0 1 120 65 A 30 30 0 0 1 160 95 A 25 25 0 0 1 150 140 Z" fill="${awake ? '#e0f2fe' : '#bae6fd'}" />
                        ${awake ? `
                            <circle cx="85" cy="100" r="6" fill="#0369a1" />
                            <circle cx="125" cy="100" r="6" fill="#0369a1" />
                            <circle cx="87" cy="98" r="2" fill="white" />
                            <circle cx="127" cy="98" r="2" fill="white" />
                            <path d="M98 112 Q105 120 112 112" stroke="#0369a1" stroke-width="3" fill="none" stroke-linecap="round"/>
                            <polygon points="145,60 135,75 142,75 132,90" fill="#facc15" />
                        ` : `
                            <path d="M78 102 Q85 107 92 102" stroke="#0284c7" stroke-width="3" fill="none" stroke-linecap="round"/>
                            <path d="M118 102 Q125 107 132 102" stroke="#0284c7" stroke-width="3" fill="none" stroke-linecap="round"/>
                            <path d="M100 112 Q105 115 110 112" stroke="#0284c7" stroke-width="2.5" fill="none"/>
                            <circle cx="72" cy="110" r="5" fill="#f43f5e" opacity="0.3" />
                            <circle cx="138" cy="110" r="5" fill="#f43f5e" opacity="0.3" />
                        `}
                    </svg>
                `
            }
        };

        function playBeepSound(type) {
            if (isAudioMuted) return;
            try {
                const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                
                if (type === 'wake') {
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(150, audioCtx.currentTime);
                    osc.frequency.exponentialRampToValueAtTime(600, audioCtx.currentTime + 0.3);
                    gain.gain.setValueAtTime(0.3, audioCtx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.4);
                    osc.start();
                    osc.stop(audioCtx.currentTime + 0.4);
                } else if (type === 'gift') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(523.25, audioCtx.currentTime);
                    osc.frequency.setValueAtTime(659.25, audioCtx.currentTime + 0.1);
                    osc.frequency.setValueAtTime(783.99, audioCtx.currentTime + 0.2);
                    osc.frequency.setValueAtTime(1046.50, audioCtx.currentTime + 0.3);
                    gain.gain.setValueAtTime(0.25, audioCtx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.5);
                    osc.start();
                    osc.stop(audioCtx.currentTime + 0.5);
                }
            } catch(e) {}
        }

        function renderCharacter() {
            const container = document.getElementById('characterBody');
            const charData = CHARACTERS[currentCharacterId];
            if (!container || !charData) return;
            
            container.innerHTML = charData.renderSVG(isAwake);
            
            if (isAwake) {
                container.classList.remove('sleeping-anim');
                container.classList.add('wake-anim');
            } else {
                container.classList.remove('wake-anim');
                container.classList.add('sleeping-anim');
            }
        }

        function initCharacterPicker() {
            const picker = document.getElementById('characterPicker');
            if (!picker) return;
            picker.innerHTML = '';
            Object.keys(CHARACTERS).forEach(id => {
                const char = CHARACTERS[id];
                const btn = document.createElement('button');
                btn.className = `p-2 rounded-xl flex flex-col items-center justify-center border transition ${currentCharacterId === id ? 'bg-indigo-600/30 border-indigo-500' : 'bg-slate-800 border-slate-700 hover:border-slate-600'}`;
                btn.innerHTML = `<span class="text-xl">${char.icon}</span><span class="text-[10px] font-bold mt-1 text-slate-300">${char.name}</span>`;
                btn.onclick = () => {
                    currentCharacterId = id;
                    initCharacterPicker();
                    renderCharacter();
                };
                picker.appendChild(btn);
            });
        }

        function createZzzParticle() {
            if (isAwake) return;
            
            const container = document.getElementById('zzzContainer');
            if (!container) return;
            const zzz = document.createElement('div');
            zzz.className = 'zzz-particle';
            zzz.innerText = Math.random() > 0.5 ? 'Zzz...' : 'Z';
            zzz.style.left = `${Math.random() * 40}px`;
            zzz.style.fontSize = `${Math.floor(Math.random() * 14) + 18}px`;
            
            container.appendChild(zzz);
            setTimeout(() => zzz.remove(), 3000);
        }

        function triggerGift(giftName, giftIcon, intensity = 'baja') {
            playBeepSound('gift');
            
            const banner = document.getElementById('giftBanner');
            if (banner) {
                document.getElementById('giftBannerIcon').innerText = giftIcon;
                document.getElementById('giftBannerName').innerText = `¡Ha enviado un ${giftName}!`;
                banner.classList.remove('hidden');

                setTimeout(() => {
                    banner.classList.add('hidden');
                }, 3500);
            }

            wakeUpCharacter(giftName);
        }

        async function wakeUpCharacter(giftSource = null) {
            isAwake = true;
            playBeepSound('wake');
            renderCharacter();

            const charData = CHARACTERS[currentCharacterId];
            const username = document.getElementById('inputViewerName')?.value.trim();
            const giftName = giftSource || 'Regalo';

            let phrase = await fetchGeminiWakeUpPhrase(charData.name, giftName, username);

            const bubble = document.getElementById('speechBubble');
            const speechText = document.getElementById('speechText');
            if (speechText) speechText.innerText = phrase;
            if (bubble) {
                bubble.classList.remove('scale-95', 'opacity-90');
                bubble.classList.add('scale-110', 'opacity-100', 'border-pink-500');
            }

            const selectedVoice = document.getElementById('selectGeminiVoice')?.value || 'Fenrir';
            playGeminiTTS(phrase, selectedVoice);

            if (awakeTimer) clearTimeout(awakeTimer);
            
            const seconds = parseInt(document.getElementById('rangeAwakeTime').value) || 4;
            awakeTimer = setTimeout(() => {
                goBackToSleep();
            }, seconds * 1000);
        }

        function goBackToSleep() {
            isAwake = false;
            renderCharacter();

            const bubble = document.getElementById('speechBubble');
            const speechText = document.getElementById('speechText');
            if (speechText) speechText.innerText = "Zzz... Zzz... 💤";
            if (bubble) {
                bubble.classList.remove('scale-110', 'opacity-100', 'border-pink-500');
                bubble.classList.add('scale-95', 'opacity-90');
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            initCharacterPicker();
            renderCharacter();

            zzzInterval = setInterval(createZzzParticle, 12000);

            const btnStartApp = document.getElementById('btnStartApp');
            if (btnStartApp) {
                btnStartApp.onclick = () => {
                    const modal = document.getElementById('startModal');
                    if (modal) modal.classList.add('hidden');
                    if (dreamInterval) clearInterval(dreamInterval);
                    dreamInterval = setInterval(fetchGeminiDream, 12000);
                    fetchGeminiDream();
                };
            }

            const connectModal = document.getElementById('connectModal');
            const btnOpenConnectModal = document.getElementById('btnOpenConnectModal');
            const btnCloseConnectModal = document.getElementById('btnCloseConnectModal');

            if (btnOpenConnectModal && connectModal) {
                btnOpenConnectModal.onclick = () => connectModal.classList.remove('hidden');
            }
            if (btnCloseConnectModal && connectModal) {
                btnCloseConnectModal.onclick = () => connectModal.classList.add('hidden');
            }

            const inputTikTokUserConfig = document.getElementById('inputTikTokUserConfig');
            const scriptUsernameText = document.getElementById('scriptUsernameText');
            if (inputTikTokUserConfig) {
                inputTikTokUserConfig.oninput = (e) => {
                    const cleanUser = e.target.value.replace('@', '').trim() || 'tu_usuario_tiktok';
                    if (scriptUsernameText) scriptUsernameText.innerText = cleanUser;
                };
            }

            const btnCopyScriptCode = document.getElementById('btnCopyScriptCode');
            if (btnCopyScriptCode) {
                btnCopyScriptCode.onclick = () => {
                    const code = document.getElementById('codeConnector').innerText;
                    navigator.clipboard.writeText(code);
                    btnCopyScriptCode.innerText = '¡Copiado!';
                    setTimeout(() => { btnCopyScriptCode.innerHTML = '<i class="fa-regular fa-copy"></i> Copiar Código'; }, 2000);
                };
            }

            function connectWebSocket() {
                const wsUrlInput = document.getElementById('inputWsUrl');
                if (!wsUrlInput) return;
                const wsUrl = wsUrlInput.value.trim();
                const statusDot = document.getElementById('tikTokStatusDot');
                const statusText = document.getElementById('tikTokStatusText');

                if (socketClient) {
                    socketClient.onclose = null;
                    socketClient.close();
                }

                try {
                    socketClient = new WebSocket(wsUrl);

                    socketClient.onopen = () => {
                        if (statusDot) statusDot.className = 'w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping';
                        if (statusText) statusText.innerText = 'TikTok Live: Conectado 🔥';
                        if (connectModal) connectModal.classList.add('hidden');
                    };

                    socketClient.onmessage = (event) => {
                        try {
                            const data = JSON.parse(event.data);
                            if (data.type === 'gift') {
                                if (data.uniqueId) {
                                    const viewerInput = document.getElementById('inputViewerName');
                                    if (viewerInput) viewerInput.value = `@${data.uniqueId}`;
                                }
                                triggerGift(data.giftName || 'Regalo', '🎁', 'alta');
                            }
                        } catch(err) {}
                    };

                    socketClient.onerror = () => {
                        if (statusDot) statusDot.className = 'w-2.5 h-2.5 rounded-full bg-red-500';
                        if (statusText) statusText.innerText = 'Desconectado';
                    };

                    socketClient.onclose = () => {
                        if (statusDot) statusDot.className = 'w-2.5 h-2.5 rounded-full bg-red-500';
                        if (statusText) statusText.innerText = 'TikTok Live: Desconectado';
                        if (autoReconnectWs) {
                            setTimeout(connectWebSocket, 4000);
                        }
                    };
                } catch(e) {
                    if (statusText) statusText.innerText = 'URL Inválida';
                }
            }

            const btnConnectWs = document.getElementById('btnConnectWs');
            if (btnConnectWs) {
                btnConnectWs.onclick = connectWebSocket;
            }

            const characterClickZone = document.getElementById('characterClickZone');
            if (characterClickZone) {
                characterClickZone.onclick = () => wakeUpCharacter();
            }

            const btnMuteSound = document.getElementById('btnMuteSound');
            if (btnMuteSound) {
                btnMuteSound.onclick = () => {
                    isAudioMuted = !isAudioMuted;
                    const icon = document.getElementById('soundIcon');
                    if (icon) {
                        icon.className = isAudioMuted ? 'fa-solid fa-volume-xmark text-red-400' : 'fa-solid fa-volume-high text-indigo-400';
                    }
                };
            }

            const rangeAwake = document.getElementById('rangeAwakeTime');
            const lblAwake = document.getElementById('lblAwakeTime');
            if (rangeAwake && lblAwake) {
                rangeAwake.oninput = (e) => {
                    lblAwake.innerText = `${e.target.value}s`;
                };
            }

            const btnToggleOverlay = document.getElementById('btnToggleOverlay');
            const btnExitOverlay = document.getElementById('btnExitOverlay');
            const controlPanel = document.getElementById('controlPanel');
            const header = document.querySelector('header');

            const toggleOverlayMode = (enable) => {
                if (enable) {
                    if (controlPanel) controlPanel.classList.add('hidden');
                    if (header) header.classList.add('hidden');
                    if (btnExitOverlay) btnExitOverlay.classList.remove('hidden');
                } else {
                    if (controlPanel) controlPanel.classList.remove('hidden');
                    if (header) header.classList.remove('hidden');
                    if (btnExitOverlay) btnExitOverlay.classList.add('hidden');
                }
            };

            if (btnToggleOverlay) btnToggleOverlay.onclick = () => toggleOverlayMode(true);
            if (btnExitOverlay) btnExitOverlay.onclick = () => toggleOverlayMode(false);

            let autoSimulating = false;
            const btnAutoSimulate = document.getElementById('btnAutoSimulate');
            if (btnAutoSimulate) {
                btnAutoSimulate.onclick = (e) => {
                    autoSimulating = !autoSimulating;
                    const btn = e.currentTarget;
                    
                    if (autoSimulating) {
                        btn.classList.add('bg-pink-600', 'text-white');
                        btn.classList.remove('bg-slate-800');
                        
                        const gifts = [
                            { name: 'Tac Tac', icon: '👆❤️', type: 'baja' },
                            { name: 'Rosa', icon: '🌹', type: 'baja' },
                            { name: 'Dona', icon: '🍩', type: 'media' },
                            { name: 'Perfume', icon: '🧴', type: 'media' },
                            { name: 'León', icon: '🦁', type: 'alta' }
                        ];

                        autoSimInterval = setInterval(() => {
                            const randomGift = gifts[Math.floor(Math.random() * gifts.length)];
                            triggerGift(randomGift.name, randomGift.icon, randomGift.type);
                        }, 14000);
                    } else {
                        btn.classList.remove('bg-pink-600', 'text-white');
                        btn.classList.add('bg-slate-800');
                        if (autoSimInterval) clearInterval(autoSimInterval);
                    }
                };
            }
        });
    </script>
</body>
</html>
